{
    "name": "btn/briefing-room",
    "type": "wordpress-plugin",
    "scripts": {
        "test": "phpunit",
        "tests-install": "bash ./tests/bin/install.sh"
    },
    "require": {
        "php": ">=8.0",
        "stellarwp/db": "^1.1",
        "league/csv": "9.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^3.0",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "BTN\\BriefingRoom\\": "src/",
            "BTN\\BriefingRoom\\Tests\\": "tests/src/",
            "BTN\\BriefingRoom\\Tests\\Factories\\": "tests/factories/"
        }
    }
}
